<mvc:View
    controllerName="app.tallyapp.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <Page
        id="dashboardPage"
        title="Tally Intelligence Dashboard"
        busy="{/busy}"
        busyIndicatorDelay="0"
        showHeader="true"
        backgroundDesign="List">

        <customHeader>
            <Bar>
                <contentLeft>
                    <core:Icon
                        src="sap-icon://document"
                        size="1.4rem"
                        color="#0070F2"
                        class="sapUiSmallMarginEnd"/>
                    <Title
                        text="Tally Intelligence Dashboard"
                        level="H2"
                        titleStyle="H4"/>
                </contentLeft>
                <contentRight>
                    <Label
                        text="{/lastRefreshed}"
                        design="Bold"
                        class="sapUiSmallMarginEnd"/>
                    <Button
                        id="fetchBtpBtn"
                        text="Fetch from BTP"
                        icon="sap-icon://cloud"
                        type="Ghost"
                        press=".onFetchBtp"
                        class="sapUiTinyMarginEnd"
                        tooltip="Manually trigger a sync from SAP BTP"/>
                    <Button
                        id="syncBtn"
                        text="Refresh UI"
                        icon="sap-icon://refresh"
                        type="Emphasized"
                        press=".onRefresh"
                        tooltip="Refresh current dashboard data"/>
                </contentRight>
            </Bar>
        </customHeader>

        <content>

            <Panel
                id="headerPanel"
                backgroundDesign="Solid"
                class="sapUiSmallMargin">

                <headerToolbar>
                    <Toolbar height="3rem">
                        <core:Icon
                            src="sap-icon://business-objects-experience"
                            size="1rem"
                            class="sapUiSmallMarginEnd"/>
                        <Title
                            text="Data Source Summary"
                            level="H3"
                            titleStyle="H5"/>
                        <ToolbarSpacer/>
                        <ObjectStatus
                            text="Manual Refresh"
                            state="Success"
                            icon="sap-icon://connected"
                            inverted="true"/>
                    </Toolbar>
                </headerToolbar>

                <HBox
                    wrap="Wrap"
                    justifyContent="SpaceBetween"
                    alignItems="Center"
                    class="sapUiSmallMargin">

                    <VBox class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                        <Label text="Company" design="Bold" class="sapUiTinyMarginBottom"/>
                        <ObjectStatus text="{/company}" state="Information" icon="sap-icon://home"/>
                    </VBox>

                    <VBox class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                        <Label text="Last Sync Date" design="Bold" class="sapUiTinyMarginBottom"/>
                        <ObjectStatus text="{/timestamp}" state="None" icon="sap-icon://appointment-2"/>
                    </VBox>

                    <VBox class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                        <Label text="Total System Records" design="Bold" class="sapUiTinyMarginBottom"/>
                        <ObjectStatus text="{/totalRecords}" state="Warning" icon="sap-icon://database"/>
                    </VBox>

                    <VBox class="sapUiSmallMarginBottom">
                        <Label text="Current Sync ID" design="Bold" class="sapUiTinyMarginBottom"/>
                        <ObjectStatus text="{/syncId}" state="None" icon="sap-icon://message-id"/>
                    </VBox>
                </HBox>
            </Panel>

            <IconTabBar
                id="tabBar"
                class="sapUiSmallMarginBeginEnd"
                select=".onTabSelect"
                expanded="{device>/system/phone}"
                selectedKey="{/tab}">

                <items>
                    <IconTabFilter key="Ledgers" text="Ledgers" icon="sap-icon://ledger">
                        <Panel backgroundDesign="Solid" class="sapUiSmallMargin">
                            <headerToolbar>
                                <Toolbar>
                                    <core:Icon src="sap-icon://table-chart" size="1rem" class="sapUiSmallMarginEnd"/>
                                    <Title text="Ledger Register" level="H3" titleStyle="H6"/>
                                    <ToolbarSpacer/>
                                    <SearchField
                                        id="searchField"
                                        placeholder="Search by ledger name…"
                                        width="22rem"
                                        liveChange=".onSearch"
                                        search=".onSearch"
                                        showRefreshButton="false"/>
                                </Toolbar>
                            </headerToolbar>

                            <Table
                                id="ledgerTable"
                                items="{path: '/ledgers'}"
                                growing="true"
                                growingThreshold="10"
                                alternateRowColors="true"
                                sticky="ColumnHeaders"
                                noDataText="No ledger records found."
                                mode="None">

                                <columns>
                                    <Column width="15%"><Text text="Ledger Name"/></Column>
                                    <Column width="14%"><Text text="Parent Group"/></Column>
                                    <Column width="8%" hAlign="Center"><Text text="Type"/></Column>
                                    <Column width="10%" hAlign="End"><Text text="Opening"/></Column>
                                    <Column width="10%" hAlign="End"><Text text="Closing"/></Column>
                                    <Column width="15%" hAlign="Center"><Text text="Sync ID"/></Column>
                                    <Column width="12%" hAlign="Center"><Text text="Sync Date"/></Column>
                                    <Column width="6%" hAlign="Center"><Text text="Ctr"/></Column>
                                </columns>

                                <items>
                                    <ColumnListItem
                                        type="Active"
                                        highlight="{path: 'closingBalance', formatter: '.formatBalanceState'}">
                                        <ObjectIdentifier title="{name}" titleActive="false"/>
                                        <Text text="{parentGroup}" wrapping="false"/>
                                        <Label text="{type}" design="Bold" wrapping="false"/>
                                        <ObjectNumber number="{path: 'openingBalance', formatter: '.formatBalance'}" state="None"/>
                                        <ObjectNumber number="{path: 'closingBalance', formatter: '.formatBalance'}" state="{path: 'closingBalance', formatter: '.formatBalanceState'}" emphasized="true"/>
                                        <Text text="{syncId}" wrapping="false"/>
                                        <Text text="{path: 'syncDate', formatter: '.formatDate'}" wrapping="false"/>
                                        <HBox alignItems="Center" justifyContent="Center">
                                            <core:Icon src="sap-icon://world" tooltip="{countryCode}" color="#0070F2" class="sapUiTinyMarginEnd"/>
                                            <Text text="{countryCode}" wrapping="false"/>
                                        </HBox>
                                    </ColumnListItem>
                                </items>
                            </Table>

                            <Toolbar height="2.5rem">
                                <core:Icon src="sap-icon://connected" color="#107E3E" class="sapUiSmallMarginEnd"/>
                                <Label text="Ledgers"/>
                                <ToolbarSpacer/>
                                <Label text="{= ${/ledgers}.length + ' records'}" design="Bold"/>
                            </Toolbar>
                        </Panel>
                    </IconTabFilter>

                    <IconTabFilter key="Vouchers" text="Vouchers" icon="sap-icon://receipt">
                        <Panel backgroundDesign="Solid" class="sapUiSmallMargin">
                            <headerToolbar>
                                <Toolbar>
                                    <core:Icon src="sap-icon://table-chart" size="1rem" class="sapUiSmallMarginEnd"/>
                                    <Title text="Voucher Register" level="H3" titleStyle="H6"/>
                                    <ToolbarSpacer/>
                                    <SearchField
                                        id="voucherSearchField"
                                        placeholder="Search by party name…"
                                        width="22rem"
                                        liveChange=".onSearch"
                                        search=".onSearch"
                                        showRefreshButton="false"/>
                                </Toolbar>
                            </headerToolbar>

                            <Table
                                id="voucherTable"
                                items="{path: '/vouchers'}"
                                growing="true"
                                growingThreshold="10"
                                alternateRowColors="true"
                                sticky="ColumnHeaders"
                                noDataText="No voucher records found."
                                mode="None">

                                <columns>
                                    <Column width="11%"><Text text="Date"/></Column>
                                    <Column width="11%"><Text text="Voucher Type"/></Column>
                                    <Column width="8%"><Text text="Voucher No"/></Column>
                                    <Column width="12%"><Text text="Party Name"/></Column>
                                    <Column width="12%"><Text text="Reference No"/></Column>
                                    <Column width="13%"><Text text="Narration"/></Column>
                                    <Column width="12%" hAlign="Center"><Text text="Sync ID"/></Column>
                                    <Column width="10%" hAlign="Center"><Text text="Sync Date"/></Column>
                                    <Column width="11%" hAlign="End"><Text text="Amount"/></Column>
                                </columns>

                                <items>
                                    <ColumnListItem type="Active">
                                        <Text text="{path: 'voucherDate', formatter: '.formatDate'}" wrapping="false"/>
                                        <Text text="{voucherType}" wrapping="false"/>
                                        <Text text="{voucherNumber}" wrapping="false"/>
                                        <ObjectIdentifier title="{partyName}" titleActive="false"/>
                                        <Text text="{referenceNo}" wrapping="false"/>
                                        <Text text="{narration}" wrapping="false" maxLines="1"/>
                                        <Text text="{syncId}" wrapping="false"/>
                                        <Text text="{path: 'syncDate', formatter: '.formatDate'}" wrapping="false"/>
                                        <ObjectNumber number="{path: 'netAmount', formatter: '.formatBalance'}" state="{path: 'netAmount', formatter: '.formatBalanceState'}" emphasized="true"/>
                                    </ColumnListItem>
                                </items>
                            </Table>

                            <Toolbar height="2.5rem">
                                <core:Icon src="sap-icon://connected" color="#107E3E" class="sapUiSmallMarginEnd"/>
                                <Label text="Vouchers"/>
                                <ToolbarSpacer/>
                                <Label text="{= ${/vouchers}.length + ' records'}" design="Bold"/>
                            </Toolbar>
                        </Panel>
                    </IconTabFilter>

                    <IconTabFilter key="StockItems" text="Stock Items" icon="sap-icon://inventory">
                        <Panel backgroundDesign="Solid" class="sapUiSmallMargin">
                            <headerToolbar>
                                <Toolbar>
                                    <core:Icon src="sap-icon://table-chart" size="1rem" class="sapUiSmallMarginEnd"/>
                                    <Title text="Stock Register" level="H3" titleStyle="H6"/>
                                    <ToolbarSpacer/>
                                    <SearchField
                                        id="stockSearchField"
                                        placeholder="Search by stock name…"
                                        width="22rem"
                                        liveChange=".onSearch"
                                        search=".onSearch"
                                        showRefreshButton="false"/>
                                </Toolbar>
                            </headerToolbar>

                            <Table
                                id="stockTable"
                                items="{path: '/stockItems'}"
                                growing="true"
                                growingThreshold="10"
                                alternateRowColors="true"
                                sticky="ColumnHeaders"
                                noDataText="No stock records found."
                                mode="None">

                                <columns>
                                    <Column width="15%"><Text text="Stock Name"/></Column>
                                    <Column width="10%"><Text text="Category"/></Column>
                                    <Column width="8%" hAlign="End"><Text text="Rate"/></Column>
                                    <Column width="8%" hAlign="End"><Text text="Qty"/></Column>
                                    <Column width="8%"><Text text="Unit"/></Column>
                                    <Column width="10%" hAlign="End"><Text text="Amount"/></Column>
                                    <Column width="15%" hAlign="Center"><Text text="Sync ID"/></Column>
                                    <Column width="13%" hAlign="Center"><Text text="Sync Date"/></Column>
                                    <Column width="8%" hAlign="End"><Text text="Closing"/></Column>
                                </columns>

                                <items>
                                    <ColumnListItem type="Active">
                                        <ObjectIdentifier title="{stockName}" titleActive="false"/>
                                        <Text text="{category}" wrapping="false"/>
                                        <ObjectNumber number="{path: 'rate', formatter: '.formatBalance'}" state="None"/>
                                        <Text text="{quantity}"/>
                                        <Text text="{unit}" wrapping="false"/>
                                        <ObjectNumber number="{path: 'amount', formatter: '.formatBalance'}" state="None"/>
                                        <Text text="{syncId}" wrapping="false"/>
                                        <Text text="{path: 'syncDate', formatter: '.formatDate'}" wrapping="false"/>
                                        <Text text="{closingStock}"/>
                                    </ColumnListItem>
                                </items>
                            </Table>

                            <Toolbar height="2.5rem">
                                <core:Icon src="sap-icon://connected" color="#107E3E" class="sapUiSmallMarginEnd"/>
                                <Label text="Stock Items"/>
                                <ToolbarSpacer/>
                                <Label text="{= ${/stockItems}.length + ' records'}" design="Bold"/>
                            </Toolbar>
                        </Panel>
                    </IconTabFilter>
                </items>
            </IconTabBar>

        </content>

        <footer>
            <Bar design="Footer">
                <contentLeft>
                    <core:Icon src="sap-icon://shield" color="#107E3E"/>
                    <Label text="  Connected · Tally Backend Service" design="Bold" class="sapUiSmallMarginBegin"/>
                </contentLeft>
                <contentRight>
                    <Label text="Tally Intelligence Dashboard · INR · India"/>
                </contentRight>
            </Bar>
        </footer>

    </Page>
</mvc:View>
